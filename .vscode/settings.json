{
    // Point to coverage generated by `just coverage`.
    "coverage-gutters.coverageReportFileName": "target/test-coverage/html/index.html",
    "coverage-gutters.coverageBaseDir": "target/test-coverage",

    // Fixes `oxiplate-derive` tests
    // that fail when the `oxiplate` feature is enabled.
    "rust-analyzer.check.workspace": false,

    // Match style used throughout codebase.
    "rust-analyzer.assist.preferSelf": true,
    "rust-analyzer.imports.granularity.group": "module",
    "rust-analyzer.imports.merge.glob": false,
    "rust-analyzer.imports.prefix": "self",
}
